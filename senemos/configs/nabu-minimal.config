# Senemos Xiaomi Pad 5 (nabu) boot-critical configuration layer.
CONFIG_LOCALVERSION="-senemos.nabu.v2.0"
# CONFIG_LOCALVERSION_AUTO is not set

CONFIG_ARCH_QCOM=y
CONFIG_PINCTRL_SM8150=y
CONFIG_SM_GCC_8150=y
CONFIG_SM_GPUCC_8150=y
CONFIG_SM_DISPCC_8250=y
CONFIG_INTERCONNECT_QCOM_SM8150=y
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_RPMH=y
CONFIG_REGULATOR_QCOM_RPMH=y

# Keep UFS and its PHY available before the root filesystem is mounted.
CONFIG_SCSI=y
CONFIG_RPMB=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_GENERIC_PHY=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_SCSI_UFS_BSG=y
CONFIG_SCSI_UFS_CRYPTO=y

# Keep Fedora Rawhide's DRM core built in; MSM and the panel stay modular.
CONFIG_DRM=y
CONFIG_DRM_MSM=m
CONFIG_DRM_PANEL_NOVATEK_NT36523=m
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_KTZ8866=m

# Remote processors, FastRPC, connectivity and persistent diagnostics.
CONFIG_REMOTEPROC=y
CONFIG_QCOM_Q6V5_PAS=m
CONFIG_QCOM_FASTRPC=m
CONFIG_RPMSG_CHAR=m
CONFIG_QCOM_RMTFS_MEM=m
CONFIG_ATH10K=m
CONFIG_ATH10K_SNOC=m
CONFIG_BT=m
CONFIG_BT_QCA=m
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_PM8XXX=m

# Fedora-compatible module packaging.
CONFIG_MODULES=y
CONFIG_MODULE_COMPRESS_ZSTD=y
